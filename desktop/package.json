{
    "name": "rabbithole-desktop",
    "version": "1.0.0",
    "description": "Rabbithole desktop app",
    "private": true,
    "type": "module",
    "main": "main.mjs",
    "scripts": {
        "build": "electron-builder --publish never"
    },
    "devDependencies": {
        "electron": "45.4.1",
        "electron-builder": "26.18.0"
    },
    "build": {
        "appId": "dev.rabbithole.desktop",
        "productName": "Rabbithole",
        "files": [
            "main.mjs",
            "shell.mjs",
            "preload.cjs",
            "starting.html",
            "icons/icon.png"
        ],
        "extraResources": [
            {
                "from": "stage",
                "to": "."
            },
            "LICENSES.md"
        ],
        "directories": {
            "output": "dist"
        },
        "publish": {
            "provider": "github",
            "owner": "Thomastienn",
            "repo": "Rabbithole"
        },
        "linux": {
            "target": "AppImage",
            "category": "Education",
            "artifactName": "Rabbithole-linux-x86_64.${ext}",
            "icon": "icons/icon.png"
        },
        "win": {
            "target": "nsis",
            "icon": "icons/icon.ico"
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "artifactName": "Rabbithole-windows-x64-setup.${ext}"
        }
    },
    "dependencies": {
        "electron-updater": "6.8.11"
    }
}
