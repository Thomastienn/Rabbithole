{
    "name": "rabbithole",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "tsc --noEmit && vite build && node scripts/build-state.mjs",
        "start": "node scripts/start.mjs",
        "serve": "node scripts/start.mjs --no-open",
        "desktop:build": "node scripts/desktop-stage.mjs && cd desktop && tauri build",
        "test": "node scripts/check-size.mjs && tsc --noEmit && systemd-run --user --scope -q -p MemoryHigh=5G -p MemorySwapMax=2G -p CPUQuota=200% node --import ./test/support/tsx.mjs --test --test-concurrency=2 --test-force-exit --test-timeout=120000 \"test/**/*.test.mjs\"",
        "test:slow": "systemd-run --user --scope -q -p MemoryHigh=5G -p MemorySwapMax=2G -p CPUQuota=200% node --import ./test/support/tsx.mjs --test --test-concurrency=2 --test-force-exit --test-timeout=120000 \"test/**/*.slow.mjs\"",
        "test:affected": "node scripts/test-affected.mjs",
        "verify": "node scripts/verify/verify-all.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@andresaya/edge-tts": "1.9.1",
        "@astryxdesign/core": "0.7.11",
        "@astryxdesign/theme-neutral": "^0.7.11",
        "@fontsource/archivo": "^5.3.0",
        "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
        "@fontsource/barlow": "^5.3.0",
        "@fontsource/barlow-semi-condensed": "^5.3.0",
        "@fontsource/literata": "^5.3.0",
        "@heroicons/react": "^2.2.0",
        "@huggingface/transformers": "4.3.2",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@mozilla/readability": "0.6.0",
        "@react-three/fiber": "9.8.2",
        "@remotion/bundler": "4.0.542",
        "@remotion/player": "4.0.542",
        "@remotion/renderer": "4.0.542",
        "@remotion/three": "4.0.542",
        "@remotion/transitions": "4.0.542",
        "@xyflow/react": "^12.12.1",
        "d3": "7.9.2",
        "diff": "^8.0.4",
        "gsap": "3.15.1",
        "jose": "^6.1.0",
        "jsdom": "29.1.1",
        "katex": "0.19.1",
        "mdast-util-directive": "^3.2.0",
        "mdast-util-from-markdown": "^2.1.0",
        "mdast-util-gfm-table": "^2.0.1",
        "mdast-util-math": "^3.0.0",
        "mermaid": "12.3.0",
        "micromark-extension-directive": "^4.0.0",
        "micromark-extension-gfm-table": "^2.1.2",
        "micromark-extension-math": "^3.1.0",
        "micromark-util-decode-string": "^2.0.1",
        "pdfjs-dist": "^6.5.438",
        "prismjs": "1.30.0",
        "proper-lockfile": "^4.1.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "remotion": "4.0.542",
        "tesseract.js": "^7.0.0",
        "three": "0.187.0",
        "typescript": "^5.9.0"
    },
    "devDependencies": {
        "@astryxdesign/cli": "0.7.11",
        "@tauri-apps/cli": "^2.12.6",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "prettier": "3.10.1",
        "vite": "^7.0.0"
    }
}
