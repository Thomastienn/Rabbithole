      "css": ".ds-delete{border:0;border-radius:var(--radius-element);padding:var(--spacing-2) var(--spacing-3);font-family:var(--font-family-body);font-size:var(--font-size-base);cursor:pointer;background:transparent;color:var(--color-text-error);box-shadow:inset 0 0 0 1px var(--color-border-error);}.ds-delete:hover{background:var(--color-overlay-hover);}.ds-delete:focus-visible{outline:var(--focus-outline-width) solid var(--color-accent);outline-offset:var(--focus-outline-offset);background:var(--color-error);color:var(--color-on-error);}",
      "refersTo": "button-destructive"
    },
    {
      "name": "Tree search",
      "kind": "input",
      "description": "Small rail search field with an accessible label and inline magnifier.",
      "html": "<label class=\"ds-search\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z\"/></svg><input type=\"search\" aria-label=\"Search learning trees\" placeholder=\"Search learning trees\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:var(--spacing-2);padding:var(--spacing-2);border:1px solid var(--color-border);border-radius:var(--radius-element);background:var(--color-background-surface);color:var(--color-text-secondary);}.ds-search input{min-width:0;width:100%;border:0;outline:0;background:transparent;color:var(--color-text-primary);font-family:var(--font-family-body);font-size:var(--font-size-sm);}.ds-search input::placeholder{color:var(--color-text-secondary);}.ds-search:hover{border-color:var(--color-border-emphasized);}.ds-search:focus-within{outline:var(--focus-outline-width) solid var(--color-accent);outline-offset:var(--focus-outline-offset);}",
      "refersTo": "search"
    },
    {
      "name": "Current learning tree",
      "kind": "nav",
      "description": "Wrapped title and muted branch count in the deeper rail.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Saved learning trees\"><button class=\"ds-tree\" aria-current=\"page\">Learning trees<span>2 branches</span></button></nav>",
      "css": ".ds-rail{background:var(--color-background-muted);padding:var(--spacing-3);}.ds-tree{border:0;border-radius:var(--radius-element);padding:var(--spacing-2) var(--spacing-3);font-family:var(--font-family-body);font-size:var(--font-size-base);cursor:pointer;width:100%;text-align:left;background:var(--color-neutral);color:var(--color-text-primary);white-space:normal;}.ds-tree span{display:block;color:var(--color-text-secondary);font-size:var(--font-size-sm);line-height:1.6667;}.ds-tree:hover{background:var(--color-overlay-hover);}.ds-tree:focus-visible{outline:var(--focus-outline-width) solid var(--color-accent);outline-offset:var(--focus-outline-offset);}",
      "refersTo": "navigation-current"
    },
    {
      "name": "Question bubble",
      "kind": "chip",
      "description": "Right-aligned question with neutral or selected chalk tint.",
      "html": "<div class=\"ds-question-row\"><p class=\"ds-question\">Why does this branch inherit context?</p></div>",
      "css": ".ds-question-row{display:flex;justify-content:flex-end;}.ds-question{margin:0;max-width:85%;padding:var(--spacing-2) var(--spacing-3);background:var(--color-neutral);color:var(--color-text-primary);font-family:var(--font-family-body);font-size:var(--font-size-base);line-height:var(--text-body-leading);border-radius:var(--radius-element);overflow-wrap:anywhere;}",
      "refersTo": "question"
    },
    {
      "name": "Focused conversation card",
      "kind": "card",
      "description": "Raised slate preview with chalk dot and yellow focused outline.",
      "html": "<article class=\"ds-card\"><button class=\"ds-card-title\"><span class=\"ds-dot\" aria-hidden=\"true\"></span>Learning trees</button><p class=\"ds-card-preview\">A conversation branches from the passage it explores.</p></article>",
      "css": ".ds-card{width:var(--treetutor-map-node-width);max-width:100%;background:var(--color-background-surface);color:var(--color-text-primary);border:1px solid var(--color-border);border-radius:var(--radius-element);outline:var(--focus-outline-width) solid var(--color-accent);outline-offset:var(--focus-outline-offset);}.ds-card-title{border:0;border-radius:var(--radius-element);padding:var(--spacing-2) var(--spacing-3);font-family:var(--font-family-body);font-size:var(--font-size-base);cursor:pointer;display:flex;align-items:center;gap:var(--spacing-2);background:transparent;color:inherit;text-align:left;font-weight:600;line-height:1.3;}.ds-dot{width:var(--spacing-2);height:var(--spacing-2);border-radius:50%;background:var(--color-text-secondary);flex:none;}.ds-card-preview{margin:0;padding:var(--spacing-2) var(--spacing-3);font-family:var(--font-family-body);font-size:var(--font-size-base);color:var(--color-text-secondary);}.ds-card:hover{border-color:var(--color-text-secondary);}.ds-card-title:hover{background:var(--color-overlay-hover);}.ds-card-title:focus-visible{outline:var(--focus-outline-width) solid var(--color-accent);outline-offset:var(--focus-outline-offset);}",
      "refersTo": "conversation-card"
    },
    {
      "name": "Tutor reply and copy",
      "kind": "custom",
      "description": "Unboxed reading text; copy reveals on hover/focus and stays visible on touch.",
      "html": "<article class=\"ds-reply\"><p>A child conversation keeps the passage that prompted the question.</p><button class=\"ds-copy\" aria-label=\"Copy reply\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-10.5A1.125 1.125 0 0 1 3 20.625V6.375c0-.621.504-1.125 1.125-1.125H6m9.75 12h4.125c.621 0 1.125-.504 1.125-1.125V3.375c0-.621-.504-1.125-1.125-1.125h-10.5C8.754 2.25 8.25 2.754 8.25 3.375V6m7.5 11.25H9.375A1.125 1.125 0 0 1 8.25 16.125V6\"/></svg></button></article>",
      "css": ".ds-reply{color:var(--color-text-primary);}.ds-reply p{max-width:62ch;margin:0;font-family:var(--treetutor-font-reading);font-size:1rem;line-height:1.7;}.ds-copy{border:0;border-radius:var(--radius-element);padding:var(--spacing-2) var(--spacing-3);font-family:var(--font-family-body);font-size:var(--font-size-base);cursor:pointer;padding:var(--spacing-1);background:transparent;color:var(--color-text-secondary);opacity:0;transition:opacity 120ms ease;}.ds-reply:is(:hover,:focus-within) .ds-copy{opacity:1;}.ds-copy:hover{background:var(--color-overlay-hover);}.ds-copy:focus-visible{outline:var(--focus-outline-width) solid var(--color-accent);outline-offset:var(--focus-outline-offset);}@media(hover:none){.ds-copy{opacity:1;}}@media(prefers-reduced-motion:reduce){.ds-copy{transition:none;}}",
      "refersTo": "reply"
    },
    {
      "name": "Inherited context",
      "kind": "custom",
      "description": "A collapsible yellow-ruled source quotation.",
      "html": "<details class=\"ds-context\" open><summary>Inherited context</summary><p>The passage that started this child question.</p></details>",
      "css": ".ds-context{border-inline-start:2px solid var(--color-accent);padding-inline-start:var(--spacing-3);color:var(--color-text-secondary);}.ds-context summary{font-family:var(--font-family-body);font-size:var(--font-size-base);padding:var(--spacing-1) 0;cursor:pointer;}.ds-context p{font-family:var(--treetutor-font-reading);font-size:var(--font-size-base);line-height:1.7;}.ds-context summary:hover{color:var(--color-text-primary);}.ds-context summary:focus-visible{outline:var(--focus-outline-width) solid var(--color-accent);outline-offset:var(--focus-outline-offset);}",
      "refersTo": "inherited-context"
    },
    {
      "name": "Source-to-branch chalk line",
      "kind": "custom",
      "description": "Shared yellow between explored passage and newly drawn focused path.",
      "html": "<div class=\"ds-branch\"><span class=\"ds-passage\">the passage being explored</span><svg viewBox=\"0 0 280 80\" width=\"280\" height=\"80\" aria-label=\"New focused branch\"><path class=\"ds-path\" d=\"M10 10 C130 10 140 65 270 65\" pathLength=\"1\"/></svg></div>",
      "css": ".ds-branch{color:var(--color-text-primary);}.ds-passage{font-family:var(--treetutor-font-reading);font-size:1rem;line-height:1.7;text-decoration:underline solid var(--color-accent);text-decoration-thickness:2px;text-underline-offset:0.2em;}.ds-branch svg{display:block;max-width:100%;}.ds-path{fill:none;stroke:var(--color-accent);stroke-width:var(--treetutor-branch-focus-width);stroke-linecap:round;animation:ds-draw var(--treetutor-branch-draw-duration) ease-out;}@keyframes ds-draw{from{stroke-dasharray:1;stroke-dashoffset:1;}to{stroke-dasharray:1;stroke-dashoffset:0;}}@media(prefers-reduced-motion:reduce){.ds-path{animation:none;}}"
    }
  ],
  "narrative": {
    "northStar": "Lecture-hall Slate",
    "overview": "TreeTutor is a calm room for following a question. Flat green-black slate, chalk-white reading text and passage-linked branches make the learning tree the visual identity. Chrome stays quiet during long reading sessions; yellow locates the active question, its source and the next action.\n\nDark is the default; light uses pale slate-paper and slate ink with the same hierarchy. Public Sans gives controls a plain voice and Source Serif 4 gives tutor replies a sustained reading rhythm. The world uses actual diagram structure rather than decorative imagery, grain, imitation chalk or handwriting.",
    "keyCharacteristics": [
      "Bare slate field and compact conversation cards",
      "One yellow action and provenance accent",
      "Unboxed serif replies against quiet grotesk controls",
      "Hairline seams, small corners and no drop shadows"
    ],
    "rules": [
      {
        "name": "The Working Chalk Rule",
        "body": "Yellow identifies primary action, focus and branch provenance. Blue, pink and green are tint or diagram-series colours, never competing action accents.",
        "section": "colors"
      },
      {
        "name": "The Reading Voice Rule",
        "body": "Tutor replies use the reading serif; questions and controls use Public Sans. Keep code in the code face.",
        "section": "typography"
      },
      {
        "name": "The Slate Seam Rule",
        "body": "Separate surfaces with tonal steps and hairlines. Do not add drop shadows, blur or texture.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep palette values in the project theme and consume semantic CSS variables.",
      "Do preserve the shared yellow between the branched passage, focused line and focused node.",
      "Do give tutor replies a 1rem/1.7 reading face and at most 62ch per block.",
      "Do preserve keyboard focus, accessible names and visible copy controls on touch.",
      "Do implement both appearances and reduced motion when extending a surface."
    ],
    "donts": [
      "Don't add grid dots, watermarks or decoration to the bare map field.",
      "Don't add drop shadows, glass, grain, chalk texture or handwriting fonts.",
      "Don't turn the secondary chalk hues into competing primary-action colours.",
      "Don't introduce remote fonts or replace questions with the reply serif.",
      "Don't replace quiet metadata with badges, decorative eyebrows or extra panels."
    ]
  }
}
